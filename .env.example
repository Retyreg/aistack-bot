BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://aistack:aistack@localhost:5433/aistack
ADMIN_IDS=
TIMEZONE=Asia/Almaty
EARLYBIRD_DEADLINE=2026-06-10
COURSE_START=2026-06-25
LANDING_URL=https://aistackca.com
LANDING_SELF=https://aistackca.com/#lead-self
LANDING_SUPPORTED=https://aistackca.com/#lead-supported
LANDING_PERSONAL=https://aistackca.com/#lead-personal
AUTHOR_CONTACT=@vatyutov
# для тестов можно поставить 1; в проде — 15
DRIP_INTERVAL_MINUTES=15
# Лид-магнит с вебинара: ссылка на Unlisted-запись эфира (кнопка под PDF)
REPLAY_URL=https://youtu.be/lsA4xftUMCk

# ─── Вебинар + цепочка напоминаний ──────────────────────────────────────
# Единственный источник правды по времени эфира. ОБЯЗАТЕЛЬНО с offset:
# +03:00 — МСК. 18:00 МСК = 20:00 Алматы. Все 4 напоминания считаются отсюда.
WEBINAR_AT=2026-08-27T18:00:00+03:00
WEBINAR_TITLE=Запуск продукта с AI-командой
# Ссылка на комнату (Zoom/YouTube Live). Пустая — кнопки «Подключиться» нет.
WEBINAR_JOIN_URL=

# ─── LLM для черновика вердикта «Аудита идеи» ───────────────────────────
# Ключ: openrouter.ai → Keys. Без него аудит работает, но черновика нет —
# админу прилетают сырые ответы с пометкой «напиши руками».
OPENROUTER_API_KEY=
# Актуальные id: openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TIMEOUT_SECONDS=90
